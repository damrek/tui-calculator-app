{
  "name": "tui-calculator-app",
  "version": "1.0.0",
  "description": "Simple Calculator TUI App",
  "main": "dist/index.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/damrek/tui-calculator-app.git"
  },
  "bugs": "https://github.com/damrek/tui-calculator-app/issues",
  "homepage": "https://github.com/damrek/tui-calculator-app#readme",
  "author": "damrek",
  "scripts": {
    "build": "tsc",
    "start": "tsx dist/index.js",
    "dev": "tsx src/index.tsx",
    "lint": "eslint src --ext .ts,.tsx",
    "format": "prettier --write src/**/*.{ts,tsx}",
    "prepare": "husky",
    "dist": "npm run build && bun run build:all",
    "build:linux": "bun build --compile --target=bun-linux-x64 ./dist/index.js --outfile ./dist/calculator-linux",
    "build:win": "bun build --compile --target=bun-windows-x64 ./dist/index.js --outfile ./dist/calculator.exe",
    "build:mac": "bun build --compile --target=bun-darwin-arm64 ./dist/index.js --outfile ./dist/calculator-macos",
    "build:all": "bun run build:linux && bun run build:win && bun run build:mac",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [],
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "ink": "^6.8.0",
    "react": "^19.2.4",
    "react-devtools-core": "^7.0.1",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.5.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "eslint": "^8.57.1",
    "eslint-plugin-react": "^4.3.0",
    "eslint-plugin-react-hooks": "^4.6.2",
    "happy-dom": "^20.9.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.5"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint",
      "prettier --write"
    ]
  }
}
